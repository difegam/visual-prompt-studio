{
  "name": "visual-prompt-studio",
  "version": "1.0.0",
  "description": "Content-first Astro starter with React, Tailwind CSS, and daisyUI",
  "author": "Your Name",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"node scripts/jsonGenerator.js && astro dev\"",
    "build": "node scripts/build.mjs production",
    "build:preview": "node scripts/build.mjs preview",
    "preview": "astro preview",
    "check": "pnpm run generate-json && astro check",
    "lint": "eslint \"src/**/*.{astro,js,mjs,cjs,jsx,ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\" astro.config.mjs eslint.config.js",
    "format": "prettier -w ./src",
    "format:check": "prettier --check .",
    "generate-json": "node scripts/jsonGenerator.js",
    "generate-llms": "node scripts/llmsGenerator.js",
    "validate:build": "node scripts/validate-build.mjs",
    "remove-darkmode": "node scripts/removeDarkmode.js && pnpm format",
    "deploy:cf-workers:development": "pnpm run build:preview && wrangler deploy --env development",
    "deploy:cf-workers:production": "pnpm run build && wrangler deploy --env production",
    "preview:cf-workers": "pnpm run build:preview && wrangler dev --env development"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@digi4care/astro-google-tagmanager": "^2.1.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/josefin-sans": "5.3.0",
    "@fontsource/limelight": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "7.4.2",
    "astro-swiper": "^2.11.0",
    "date-fns": "^4.4.0",
    "disqus-react": "^1.1.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "node-html-parser": "^9.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.152.0"
  }
}
