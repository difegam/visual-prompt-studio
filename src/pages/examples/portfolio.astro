---
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/examples/portfolio/projects";
---

<Base
  title="Portfolio example"
  description="Optional portfolio card example for this starter."
  noindex={true}
>
  <section class="section-sm">
    <div class="container">
      <header class="mx-auto mb-10 max-w-2xl text-center">
        <p
          class="text-text-light mb-2 text-sm font-semibold tracking-wide uppercase"
        >
          Optional example
        </p>
        <h1 class="text-h2 mb-4">Portfolio projects</h1>
        <p class="text-text dark:text-darkmode-text">
          This route demonstrates a narrowly typed project card. Replace the
          sample records with your own or remove this page and its component.
        </p>
      </header>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
