---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "-index");
const { contact_form_action }: { contact_form_action: string } = config.params;
const hasFormHandler = Boolean(
  contact_form_action && contact_form_action !== "#",
);
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          {
            !hasFormHandler && (
              <p class="bg-light dark:bg-darkmode-light mb-6 rounded-lg p-4">
                This example form is inactive. Configure a secure form handler
                in
                <code>src/config/config.json</code> before enabling submissions.
              </p>
            )
          }
          <form
            action={hasFormHandler ? contact_form_action : undefined}
            method="POST"
          >
            <div class="mb-6">
              <label for="name" class="form-label">
                Full Name <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                class="form-input"
                placeholder="Your name"
                type="text"
                required
                disabled={!hasFormHandler}
              />
            </div>
            <div class="mb-6">
              <label for="email" class="form-label">
                Working Mail <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                class="form-input"
                placeholder="you@example.com"
                type="email"
                required
                disabled={!hasFormHandler}
              />
            </div>
            <div class="mb-6">
              <label for="message" class="form-label">
                Anything else? <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input"
                placeholder="Message goes here..."
                required
                disabled={!hasFormHandler}
                rows="8"></textarea>
            </div>
            <button
              type="submit"
              class="btn btn-primary"
              disabled={!hasFormHandler}
            >
              Submit
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
