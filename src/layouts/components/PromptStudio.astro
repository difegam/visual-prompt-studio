---
import "@/lib/prompt-studio/ui/fonts.css";
import "@/lib/prompt-studio/ui/styles.css";
import StudioField from "@/layouts/components/StudioField.astro";
import StudioDisclosure from "@/layouts/components/StudioDisclosure.astro";
import ThemeSwitcher from "@/layouts/components/ThemeSwitcher.astro";
import FieldInfo from "@/layouts/components/FieldInfo.astro";
---

<div id="studio-app">
  <header class="bar">
    <a class="brand" href="#compose" aria-label="Visual Prompt Studio">
      <svg class="reg" viewBox="0 0 24 24" aria-hidden="true"
        ><circle cx="12" cy="12" r="6.5"></circle><path d="M12 1v22M1 12h22"
        ></path><circle cx="12" cy="12" r="2.4" class="reg-dot"></circle></svg
      >
      <span>Visual Prompt Studio</span>
    </a>
    <nav class="bar-nav" aria-label="Sections">
      <a href="#compose">Compose</a>
      <a href="#inspiration">Inspiration</a>
    </nav>
    <div class="bar-actions">
      <button
        type="button"
        class="btn ghost"
        id="btn-import"
        aria-label="Import recipe">Import</button
      >
      <button
        type="button"
        class="btn ghost"
        id="btn-export"
        aria-label="Export recipe">Export</button
      >
      <button type="button" class="btn ghost" id="btn-reset">Reset</button>
      <ThemeSwitcher className="studio-theme-switcher" />
    </div>
  </header>

  <main class="studio" id="compose">
    <div class="composer">
      <section class="brief" aria-labelledby="brief-h">
        <h1 id="brief-h" class="lede">Give the image a point of view.</h1>
        <div class="field-heading">
          <label class="idea-label" for="f-idea">What are you making?</label>
          <FieldInfo
            label="What are you making?"
            id="idea"
            info="Describe the subject and where the image will be used. A clear brief gives the prompt a concrete starting point."
          />
        </div>
        <textarea
          id="f-idea"
          class="idea textarea"
          rows="2"
          maxlength="400"
          aria-describedby="idea-error"
          spellcheck="true"></textarea>
        <p class="field-error" id="idea-error" hidden>
          Describe it in a few words so the model has a subject.
        </p>

        <div class="starts">
          <span class="starts-label" id="starts-label"
            >Start from an example</span
          >
          <div
            class="starts-row"
            id="presets"
            role="list"
            aria-labelledby="starts-label"
          >
          </div>
        </div>

        <div class="grid-fields">
          <StudioField
            label="Format"
            controlId="f-purpose"
            info="Choose the kind of image you are making. The selected format guides the prompt's composition and use."
          >
            <select id="f-purpose" class="select"></select>
          </StudioField>
          <div class="field">
            <div class="field-heading">
              <span id="aspect-label">Aspect ratio</span>
              <FieldInfo
                label="Aspect ratio"
                id="aspect"
                info="Choose the canvas shape that fits where you plan to use the image. This changes the prompt's framing."
              />
            </div>
            <div
              class="seg aspect-seg"
              id="f-aspect"
              role="radiogroup"
              aria-labelledby="aspect-label"
            >
            </div>
          </div>
          <StudioField
            label="Headline"
            controlId="f-headline"
            info="Enter the main words that should appear in the image. Keep it short for stronger placement and legibility."
          >
            <input
              id="f-headline"
              class="input"
              type="text"
              maxlength="80"
              autocomplete="off"
            />
          </StudioField>
          <StudioField
            label="Other text"
            controlId="f-extra"
            hint="one line each, up to 4"
            info="Add supporting words such as a date, venue, or credit. Put each separate text element on its own line."
          >
            <textarea id="f-extra" class="textarea" rows="2" maxlength="323"
            ></textarea>
          </StudioField>
          <div class="field span2">
            <div class="field-heading">
              <span id="textmode-label">Text in the image</span>
              <FieldInfo
                label="Text in the image"
                id="textmode"
                info="Choose whether the image model should render the supplied wording or leave a clear area for you to add type later."
              />
            </div>
            <div class="seg" role="radiogroup" aria-labelledby="textmode-label">
              <label class="seg-option">
                <input
                  class="radio"
                  type="radio"
                  name="textmode"
                  value="render"
                  data-textmode="render"
                />
                <span>Render the exact text</span>
              </label>
              <label class="seg-option">
                <input
                  class="radio"
                  type="radio"
                  name="textmode"
                  value="space"
                  data-textmode="space"
                />
                <span>Leave clean space, I'll set it later</span>
              </label>
            </div>
          </div>
          <StudioField
            label="Your concept"
            controlId="f-detail"
            hint="one specific image idea beats ten adjectives"
            className="span2"
            info="Describe one memorable visual metaphor or scene. A concrete image idea is easier for a model to follow than a list of style adjectives."
          >
            <input
              id="f-detail"
              class="input"
              type="text"
              maxlength="240"
              autocomplete="off"
            />
          </StudioField>
        </div>
      </section>

      <section class="layers" aria-labelledby="layers-h">
        <div class="section-head">
          <div class="field-heading section-title-row">
            <h2 id="layers-h">Visual language</h2>
            <FieldInfo
              label="Visual language"
              id="visual-language"
              info="Choose one layout, one kind of imagery, and one finish. These layers combine into a single art direction."
            />
          </div>
          <p>
            Pick one per layer. Each controls a different part of the image, so
            they combine.
          </p>
        </div>
        <div class="tabs" role="tablist" aria-label="Style layers">
          <button
            type="button"
            role="tab"
            id="tab-design"
            aria-controls="panel-design"
            data-layer="design"
            ><i class="sep c"></i>Layout<small id="cur-design"></small></button
          >
          <button
            type="button"
            role="tab"
            id="tab-art"
            aria-controls="panel-art"
            data-layer="art"
            ><i class="sep m"></i>Imagery<small id="cur-art"></small></button
          >
          <button
            type="button"
            role="tab"
            id="tab-technique"
            aria-controls="panel-technique"
            data-layer="technique"
            ><i class="sep y"></i>Finish<small id="cur-technique"
            ></small></button
          >
        </div>
        <div
          class="tile-grid"
          id="panel-design"
          role="tabpanel"
          aria-labelledby="tab-design"
        >
        </div>
        <div
          class="tile-grid"
          id="panel-art"
          role="tabpanel"
          aria-labelledby="tab-art"
          hidden
        >
        </div>
        <div
          class="tile-grid"
          id="panel-technique"
          role="tabpanel"
          aria-labelledby="tab-technique"
          hidden
        >
        </div>

        <div class="mixes">
          <button type="button" class="btn" id="btn-shuffle"
            >Shuffle a clashing mix</button
          >
          <div class="mix-row" id="mixes"></div>
        </div>

        <div class="palette-block">
          <div class="palette-head">
            <div class="field-heading section-title-row">
              <h3>Palette</h3>
              <FieldInfo
                label="Palette"
                id="palette"
                info="The three inks define the image's ground and two main colors. The prompt asks the model to avoid adding extra colors."
              />
            </div>
            <p id="palette-note">Three inks. Click a swatch to change it.</p>
          </div>
          <div class="palette-row">
            <div class="swatches" id="swatches"></div>
            <div class="variations" id="variations"></div>
          </div>
        </div>
      </section>

      <StudioDisclosure
        title="Fine-tune the direction"
        description="Typography, exclusions and creative intent"
        className="fine-tune"
      >
        <section aria-labelledby="type-h">
          <div class="section-head">
            <div class="field-heading section-title-row">
              <h2 id="type-h">Typography</h2>
              <FieldInfo
                label="Typography"
                id="typography"
                info="These specimens set a broad type character for the image model. Add an exact brand font afterward if needed."
              />
            </div>
            <p>
              Choose a type character. Add the final brand font in your image
              editor when exact lettering matters.
            </p>
          </div>
          <div class="specimens" id="specimens"></div>
        </section>

        <section aria-labelledby="avoid-h">
          <div class="section-head">
            <div class="field-heading section-title-row">
              <h2 id="avoid-h">Remove the default look</h2>
              <FieldInfo
                label="Remove the default look"
                id="avoid"
                info="Exclude familiar AI embellishments or subject clichés. An exclusion is skipped if the chosen print finish depends on it."
              />
            </div>
            <p>
              Name what to leave out. Exclusions a chosen style depends on are
              skipped automatically.
            </p>
          </div>
          <StudioField
            label="Clichés of this subject"
            controlId="f-cliche"
            className="inline"
            info="Pick a subject category to see common visual clichés you may want the prompt to avoid."
          >
            <select id="f-cliche" class="select"></select>
          </StudioField>
          <p class="cliche-items" id="cliche-items"></p>
          <div class="chip-groups" id="avoids"></div>
          <div class="chip-actions">
            <button type="button" class="link" id="avoid-defaults"
              >Use sensible defaults</button
            >
            <button type="button" class="link" id="avoid-clear"
              >Clear all</button
            >
          </div>
        </section>

        <section aria-labelledby="sig-h">
          <div class="section-head">
            <div class="field-heading section-title-row">
              <h2 id="sig-h">Authorial intent</h2>
              <FieldInfo
                label="Authorial intent"
                id="authorial-intent"
                info="Choose the principles that should shape the result, such as material realism or confident restraint. This is optional."
              />
            </div>
            <p>
              Optional. One or two lines that make the brief sound like a person
              made a decision.
            </p>
          </div>
          <div class="signatures" id="signatures"></div>
        </section>
      </StudioDisclosure>
    </div>

    <aside class="proof" aria-labelledby="proof-h">
      <div class="proof-inner">
        <h2 id="proof-h" class="sr-only">Proof and prompt</h2>
        <figure class="sheet card card-border">
          <div class="crop" id="proof"></div>
          <figcaption>
            <ul class="seps" id="seps"></ul>
            <p class="caveat">
              Vector study of the direction, not a generated image.
            </p>
          </figcaption>
        </figure>

        <div class="target-block">
          <div class="field-heading">
            <span class="mini-label" id="target-label">Send to</span>
            <FieldInfo
              label="Send to"
              id="target"
              info="Select the image model you plan to use. The prompt and available settings adapt to that model; this studio does not generate the image."
            />
          </div>
          <div
            class="seg wrap"
            id="f-target"
            role="radiogroup"
            aria-labelledby="target-label"
          >
          </div>
          <p class="target-note" id="target-note"></p>
        </div>

        <div class="pattern-row">
          <StudioField
            label="Prompt shape"
            controlId="f-pattern"
            info="Choose how the prompt is organized. The art direction keeps it compact; the production spec adds more explicit constraints."
          >
            <select id="f-pattern" class="select"></select>
          </StudioField>
          <div class="field" id="lang-field">
            <div class="field-heading">
              <span id="lang-label">Language</span>
              <FieldInfo
                label="Language"
                id="language"
                info="This changes the language of the generated prompt. It does not translate the text entered for the image."
              />
            </div>
            <div class="seg" role="radiogroup" aria-labelledby="lang-label">
              <label class="seg-option">
                <input
                  class="radio"
                  type="radio"
                  name="language"
                  value="en"
                  data-lang="en"
                />
                <span>EN</span>
              </label>
              <label class="seg-option">
                <input
                  class="radio"
                  type="radio"
                  name="language"
                  value="es"
                  data-lang="es"
                />
                <span>ES</span>
              </label>
            </div>
          </div>
        </div>
        <p class="pattern-hint" id="pattern-hint"></p>

        <div class="ctx" id="edit-fields" hidden>
          <div class="field">
            <div class="field-heading">
              <label for="f-change">Change only</label>
              <FieldInfo
                label="Change only"
                id="change-only"
                info="Describe the specific part to edit. The prompt asks the model to leave everything else untouched."
              />
            </div>
            <input
              id="f-change"
              class="input"
              type="text"
              maxlength="240"
              placeholder="e.g. the background, to flat cobalt blue"
            />
          </div>
          <div class="field">
            <div class="field-heading">
              <label for="f-preserve">Keep exactly</label>
              <FieldInfo
                label="Keep exactly"
                id="keep-exactly"
                info="List the subjects, placement, and text that should remain unchanged in the edit."
              />
            </div>
            <input
              id="f-preserve"
              class="input"
              type="text"
              maxlength="240"
              placeholder="e.g. the vase, its position and all text"
            />
          </div>
        </div>

        <div class="ctx" id="mj-fields" hidden>
          <div class="field">
            <div class="field-heading">
              <label for="f-sref"
                >Style reference codes <small>--sref, space separated</small
                ></label
              >
              <FieldInfo
                label="Style reference codes"
                id="style-reference-codes"
                info="Add one or more numeric Midjourney style reference codes, separated by spaces. These are passed through as --sref values."
              />
            </div>
            <input
              id="f-sref"
              class="input"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder="e.g. 2378124706"
            />
          </div>
          <p class="field-error" id="sref-error" hidden></p>
          <div class="mj-row">
            <div class="check-row">
              <label class="check" for="f-raw">
                <input id="f-raw" class="checkbox" type="checkbox" />
                <span>--raw <small>skip default beautification</small></span>
              </label>
              <FieldInfo
                label="Raw mode"
                id="raw-mode"
                info="Passes Midjourney's --raw flag to reduce its default beautification and give your art direction more influence."
              />
            </div>
            <StudioField
              label="--s stylize"
              controlId="f-stylize"
              className="small"
              info="Controls how strongly Midjourney applies its own aesthetic defaults. Leave it blank to use the model's default."
            >
              <input
                id="f-stylize"
                class="input"
                type="number"
                min="0"
                max="1000"
                step="50"
                placeholder="default"
              />
            </StudioField>
          </div>
        </div>

        <div class="prompt-box">
          <div class="prompt-head">
            <span class="mini-label" id="prompt-label">Prompt</span>
            <span class="count" id="prompt-count"></span>
          </div>
          <div
            class="prompt"
            id="prompt"
            tabindex="0"
            aria-labelledby="prompt-label"
          >
          </div>
          <div id="neg-wrap" hidden>
            <div class="prompt-head">
              <span class="mini-label">Negative prompt</span>
            </div>
            <div class="prompt neg" id="neg" tabindex="0"></div>
          </div>
          <ul class="notices" id="notices"></ul>
        </div>

        <div class="actions">
          <button type="button" class="btn primary" id="btn-copy"
            >Copy prompt</button
          >
          <button type="button" class="btn" id="btn-copy-neg" hidden
            >Copy negative</button
          >
          <button
            type="button"
            class="btn ghost"
            id="btn-baseline"
            aria-pressed="false">Compare with an undirected prompt</button
          >
        </div>
        <p class="baseline" id="baseline" hidden></p>
        <p class="status" id="status" role="status" aria-live="polite"></p>
      </div>
    </aside>
  </main>

  <section class="inspiration" id="inspiration" aria-labelledby="insp-h">
    <div class="insp-inner">
      <div class="section-head wide">
        <h2 id="insp-h">Where to look next</h2>
        <p>
          Sources for styles, style codes and tested prompts. Links follow your
          current selection. Each entry was visited and checked on the date
          shown.
        </p>
      </div>
      <div
        class="filters"
        id="ref-filters"
        role="toolbar"
        aria-label="Filter sources"
      >
      </div>
      <div class="refs" id="refs"></div>
    </div>
  </section>

  <footer class="foot">
    <p>
      Runs in your browser. No account, no API key, no generation. Previews are
      original vector studies; style names are educational approximations.
    </p>
    <p>
      Catalog structure after the beailabs guide and John Hartnup's Poster
      Prompts. Fonts are OFL-1.1 via Fontsource.
    </p>
  </footer>

  <div class="mobile-bar" id="mobile-bar">
    <a class="btn" href="#proof-h">See prompt</a>
    <button type="button" class="btn primary" id="btn-copy-mobile"
      >Copy prompt</button
    >
  </div>

  <dialog id="dlg-export" aria-labelledby="exp-h">
    <form method="dialog" class="dlg">
      <h2 id="exp-h">Export recipe</h2>
      <p>The full recipe as JSON. Import it later to restore every choice.</p>
      <textarea id="exp-json" rows="14" readonly spellcheck="false"></textarea>
      <div class="dlg-actions">
        <button type="button" class="btn primary" id="exp-copy"
          >Copy JSON</button
        >
        <button type="button" class="btn" id="exp-download" hidden
          >Download .json</button
        >
        <button class="btn ghost" value="close">Close</button>
      </div>
    </form>
  </dialog>

  <dialog id="dlg-import" aria-labelledby="imp-h">
    <form method="dialog" class="dlg" id="imp-form">
      <h2 id="imp-h">Import recipe</h2>
      <p>
        Paste a recipe JSON or choose a .json file. It is validated before
        anything changes.
      </p>
      <textarea id="imp-json" rows="12" spellcheck="false"></textarea>
      <label class="file"
        ><input id="imp-file" type="file" accept="application/json,.json" />
        <span>Choose a file</span></label
      >
      <ul class="issues" id="imp-issues" hidden></ul>
      <div class="dlg-actions">
        <button type="button" class="btn primary" id="imp-apply">Import</button>
        <button class="btn ghost" value="close">Cancel</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { startApp } from "@/lib/prompt-studio/ui/app";

  const mountStudio = (): void => {
    const root = document.getElementById("studio-app");
    if (!root || root.dataset.started === "true") return;
    root.dataset.started = "true";
    startApp();
  };

  mountStudio();
  document.addEventListener("astro:page-load", mountStudio);
</script>
