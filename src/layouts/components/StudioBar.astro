---
import ThemeSwitcher from "@/layouts/components/ThemeSwitcher.astro";

export interface Props {
  /** `app` carries the recipe actions; `page` is the plain bar for secondary pages. */
  variant?: "app" | "page";
  current?: "guide";
}

const { variant = "app", current } = Astro.props;
const repo = "https://github.com/difegam/visual-prompt-studio";
const home = variant === "app" ? "" : "/";
---

<header class="bar">
  <a class="brand" href={`${home}#compose`} aria-label="Visual Prompt Studio">
    <svg class="reg" viewBox="0 0 24 24" aria-hidden="true"
      ><circle cx="12" cy="12" r="6.5"></circle><path d="M12 1v22M1 12h22"
      ></path><circle cx="12" cy="12" r="2.4" class="reg-dot"></circle></svg
    >
    <span>Visual Prompt Studio</span>
  </a>
  <details class="bar-menu" open>
    <summary class="bar-menu-toggle">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path class="ico-open" d="M4 7h16M4 12h16M4 17h16"></path><path
          class="ico-close"
          d="M6 6l12 12M18 6L6 18"></path></svg
      >
      <span>Menu</span>
    </summary>
    <div class="bar-panel">
      <nav class="bar-nav" aria-label="Sections">
        <a href={`${home}#compose`}>Compose</a>
        <a href="/guide" aria-current={current === "guide" ? "page" : undefined}
          >Guide</a
        >
        <a href={`${home}#inspiration`}>Inspiration</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </nav>
      {
        variant === "app" && (
          <div class="bar-tools">
            <button
              type="button"
              class="btn ghost"
              id="btn-import"
              aria-label="Import recipe"
            >
              Import
            </button>
            <button
              type="button"
              class="btn ghost"
              id="btn-export"
              aria-label="Export recipe"
            >
              Export
            </button>
            <button type="button" class="btn ghost" id="btn-reset">
              Reset
            </button>
          </div>
        )
      }
    </div>
  </details>
  <div class="bar-actions">
    <a
      class="bar-icon"
      href={repo}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub repository"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path></svg
      >
    </a>
    <ThemeSwitcher className="studio-theme-switcher" />
  </div>
</header>

<script>
  // Desktop shows the menu inline (open); narrower screens collapse it.
  const menu = document.querySelector<HTMLDetailsElement>(".bar-menu");
  if (menu) {
    const wide = matchMedia("(min-width: 1024px)");
    const sync = () => {
      menu.open = wide.matches;
    };
    sync();
    wide.addEventListener("change", sync);
    menu.addEventListener("click", (e) => {
      if (!wide.matches && (e.target as Element).closest("a, button"))
        menu.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !wide.matches && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
