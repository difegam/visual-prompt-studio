{
  "site": {
    "title": "Visual Prompt Studio",
    "base_url": "https://example.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/favicon.svg",
    "logo": "",
    "logo_darkmode": "",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "Visual Prompt Studio"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 6,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": false,
    "content": "",
    "expire_days": 7
  },

  "params": {
    "copyright": "Visual Prompt Studio. Built on [Astroplate](https://github.com/zeon-studio/astroplate) (MIT)."
  },

  "navigation_button": {
    "enable": false,
    "label": "Open the Studio",
    "link": "/"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "metadata": {
    "meta_author": "Visual Prompt Studio",
    "meta_image": "/social-card.svg",
    "meta_description": "Compose clear, art-directed image prompts with layered visual language, exact text, and model-aware controls."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
