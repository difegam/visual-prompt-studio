{
  "site": {
    "title": "Visual Prompt Studio",
    "base_url": "https://example.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/favicon.svg",
    "logo": "",
    "logo_darkmode": "",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "Visual Prompt Studio"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 6,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": false,
    "content": "",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "",
    "copyright": "© [Your Organization](https://example.com). Replace this credit before launch."
  },

  "navigation_button": {
    "enable": false,
    "label": "Contact us",
    "link": "/contact"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "your-disqus-shortname",
    "settings": {}
  },

  "metadata": {
    "meta_author": "Visual Prompt Studio",
    "meta_image": "/social-card.svg",
    "meta_description": "Compose clear, art-directed image prompts with layered visual language, exact text, and model-aware controls."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
