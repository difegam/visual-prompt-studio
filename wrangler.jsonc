{
  // Cloudflare Workers — Static Assets deployment
  // Deploy only through an explicit environment: development or production.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visual-prompt-studio-development",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  "env": {
    "development": {
      "name": "visual-prompt-studio-development",
      "routes": [{ "pattern": "vps-dev.dgamboa.com", "custom_domain": true }],
    },
    "production": {
      "name": "visual-prompt-studio-production",
      "routes": [{ "pattern": "vps.dgamboa.com", "custom_domain": true }],
    },
  },
}
