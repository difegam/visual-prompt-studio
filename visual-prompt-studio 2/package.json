{
  "name": "visual-prompt-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first, copy-first image prompt composer with a layered style catalog.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/josefin-sans": "5.3.0",
    "@fontsource/limelight": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
